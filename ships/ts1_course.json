					"in": [
						"T01_zoom"
					]
				},
				{
					"id": "hold",
					"text": {
						"zh": "按住 V：悬停锁定，无人机原地不动",
						"en": "HOLD V: HOVER LOCK, THE DRONE STAYS PUT"
					},
					"tools": [],
					"done": {
						"hold": true
					},
					"in": [
						"T01_hold"
					]
				},
				{
					"id": "assist",
					"text": {
						"zh": "按 F 关掉飞行稳定，再打开",
						"en": "F: ASSIST OFF, THEN ON"
					},
					"tools": [],
					"done": {
						"assist_cycle": true
					},
					"in": [
						"T01_f"
					]
				},
