					],
					"target": {
						"box": true
					}
				},
				{
					"id": "pan",
					"text": {
						"zh": "按住右键拖动画面，看看四周",
						"en": "HOLD RIGHT MOUSE AND DRAG: LOOK AROUND"
					},
					"tools": [],
					"done": {
						"panned": true
					},
					"in": [
						"T01_pan"
					]
				},
				{
					"id": "overview",
					"text": {
						"zh": "按住 Z 拉远，看清整个舱段",
						"en": "HOLD Z: PULL BACK, SEE ALL OF IT"
					},
					"tools": [],
					"done": {
						"overview": true
