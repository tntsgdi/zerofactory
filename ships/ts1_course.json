		"TF_scrap_t": {
			"who": "term",
			"zh": "金属废料接收完成。",
			"en": "SCRAP RECEIVED."
		},
		"TF_equip_t": {
			"who": "term",
			"zh": "设备接收完成：完整。",
			"en": "EQUIPMENT RECEIVED: WHOLE."
		},
		"TF_haz_t": {
			"who": "term",
			"zh": "危险品接收完成。",
			"en": "HAZARD RECEIVED."
		},
		"TL_lock_t": {
			"who": "term",
			"zh": "训练安全联锁启动：容器内仍有液体。",
			"en": "TRAINING INTERLOCK: THE VESSEL STILL HOLDS LIQUID."
		},
		"TL_empty_t": {
			"who": "term",
			"zh": "液体回收完成。",
			"en": "LIQUID RECOVERED."
		}
