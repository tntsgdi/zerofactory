static func t(key: String) -> String:
	var v = S.get(key)
	if v == null:
		return key
	var text: String = v[0] if zh else v[1]
	if key in ["fa_hauler_d", "fa_crane_d"]:
		return text % Keys.label("mark")
	if key == "hint_equip_rail":
		return text % Keys.label("mouth")
	return text


static func has(key: String) -> bool:
	return S.has(key)


# a declared cargo label ("IND. METAL") by its name in the player's language
static func cargo(label: String) -> String:
	for k in Variant.CARGO:
		if Variant.CARGO[k][0] == label:
			return t("cargo_" + k)
	return label


static func piece_name(p) -> String:
	if p == null:
		return ""
	if p.name_key != "":
		var n := t(p.name_key)
		if p.get("label") != null and p.label != "" and cargo(p.label) != p.label:
			n += " · " + cargo(p.label)
		return n + ("  " + p.tag if p.tag != "" else "")
	var k: String = "k_" + p.kind
	if p.tag != "":
		return t(k) + "  " + p.tag
	return t(k)


static func load_settings(testing: bool) -> void:
	zh = OS.get_locale_language() == "zh"
	if testing:
		zh = test_zh
		return
	var cf := ConfigFile.new()
	if cf.load(cfg_path) == OK:
		zh = cf.get_value("ui", "zh", zh)
		hints = cf.get_value("ui", "hints", true)
		assist = cf.get_value("ui", "assist", true)
		certified = cf.get_value("career", "certified", false)
		cert_kind = cf.get_value("career", "cert_kind", "")
		exam_grade = cf.get_value("career", "exam_grade", "")
		# one hint level for every contract (the user, 2026-10-17: no light / heavy hints to choose)
		hint_tier = "standard"
		clues = cf.get_value("career", "clues", [])
		chapter_done = cf.get_value("career", "chapter_done", false)
		dev = cf.get_value("ui", "dev", false)
		context = cf.get_value("ui", "context", true)
		fullscreen = cf.get_value("video", "fullscreen", false)
		calm = cf.get_value("video", "calm", false)
		anim = cf.get_value("video", "anim", "full")
		if not anim in ANIM_LEVELS:
			anim = "full"
		Keys.load_from(cf)
		vol_master = cf.get_value("audio", "master", 1.0)
		vol_music = cf.get_value("audio", "music", 0.8)
		vol_sfx = cf.get_value("audio", "sfx", 0.9)
		quality = cf.get_value("video", "quality", "high")


static func save_settings(testing: bool) -> void:
	if testing:
		return
	var cf := ConfigFile.new()
	cf.set_value("ui", "zh", zh)
	cf.set_value("ui", "hints", hints)
	cf.set_value("ui", "assist", assist)
	cf.set_value("career", "certified", certified)
	cf.set_value("career", "cert_kind", cert_kind)
	cf.set_value("career", "exam_grade", exam_grade)
	cf.set_value("ui", "hint_tier", hint_tier)
	cf.set_value("career", "clues", clues)
	cf.set_value("career", "chapter_done", chapter_done)
	cf.set_value("ui", "dev", dev)
	cf.set_value("ui", "context", context)
	cf.set_value("video", "fullscreen", fullscreen)
	cf.set_value("video", "calm", calm)
	cf.set_value("video", "anim", anim)
	Keys.store(cf)
	cf.set_value("audio", "master", vol_master)
	cf.set_value("audio", "music", vol_music)
	cf.set_value("audio", "sfx", vol_sfx)
	cf.set_value("video", "quality", quality)
	cf.save(cfg_path)
